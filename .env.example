# Kopiér denne fil til .env og udfyld værdierne:  cp .env.example .env
# .env committes ALDRIG (den står i .gitignore). Dette er kun en skabelon.

# --- Database (lokal PostgreSQL via docker-compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataleads
DB_USER=dataleads
DB_PASSWORD=change_me
# 'disable' lokalt (lokal Postgres har ingen TLS); staging/prod bruger 'require' (default der).
DB_SSLMODE=disable

# --- CVR API (gratis nøgle) ---
CVR_API_KEY=your_free_key_here

# --- Stripe (kommer i fase 4) ---
STRIPE_SECRET_KEY=comes_in_phase_4
